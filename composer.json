{
	"name": "haltuf/rabbitmq",
	"description": "Lightweight RabbitMQ integration for Nette Framework on top of php-amqplib. Seamless switch from the abandoned contributte/rabbitmq.",
	"type": "library",
	"license": "MIT",
	"keywords": ["rabbitmq", "amqp", "nette", "queue", "messaging", "php-amqplib"],
	"authors": [
		{
			"name": "Michal Haltuf",
			"homepage": "https://www.michalhaltuf.cz"
		}
	],
	"require": {
		"php": "^8.3",
		"php-amqplib/php-amqplib": "^3.7",
		"nette/di": "^3.1",
		"symfony/console": "^6.0 || ^7.0"
	},
	"require-dev": {
		"nette/tester": "^2.5",
		"phpstan/phpstan": "^2.1",
		"phpstan/phpstan-nette": "^2.0",
		"slevomat/coding-standard": "^8.18",
		"squizlabs/php_codesniffer": "^3.12",
		"symplify/easy-coding-standard": "^12.5"
	},
	"autoload": {
		"psr-4": {
			"Haltuf\\RabbitMQ\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Haltuf\\RabbitMQ\\Tests\\": "tests/"
		}
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"phpstan/extension-installer": true
		},
		"sort-packages": true
	},
	"scripts": {
		"phpstan": "vendor/bin/phpstan analyse",
		"ecs": "vendor/bin/ecs check",
		"ecs:fix": "vendor/bin/ecs check --fix",
		"tester": "vendor/bin/tester tests",
		"check": [
			"@phpstan",
			"@ecs",
			"@tester"
		]
	}
}
